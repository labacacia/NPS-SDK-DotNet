<Project>

  <PropertyGroup>
    <Version>1.0.0-alpha.20</Version>
    <PackageReleaseNotes>1.0.0-alpha.20 candidate: opt-in bounded data workflows, result authorization and honest transport/model measurements. Reference paths and SDK helper coverage differ; full production parity and beta are not qualified. Not yet published.</PackageReleaseNotes>
    <!-- XML documentation files are generated, but the alpha SDK still has broad
         public-surface doc gaps; keep compile output clean until the doc sweep. -->
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1574;CS1734</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
